# ==============================================================================
# TeknoyCart Local Environment Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file and rename it to `application-local.yml` in this directory:
#    cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# 2. Populate your local secrets below.
# 3. `application-local.yml` is explicitly ignored by .gitignore to protect secrets.
# ==============================================================================

spring:
  mail:
    username: your-email@gmail.com
    password: your-gmail-app-password
  datasource:
    url: jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
    username: postgres.your-project-id
    password: your-database-password

jwt:
  secret: your-secure-random-256-bit-jwt-secret-key-here

brevo:
  api:
    key: your-brevo-api-key-here
