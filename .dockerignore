**/application-local*.yml
!**/application-local.yml.example
**/*firebase*.json
**/serviceAccountKey.json
**/*.env
**/*.key
**/*.pem
**/*.p12
**/*.log

# Python harness artifacts (not part of the app)
**/__pycache__/
**/*.pyc
test_*.py
